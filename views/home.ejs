<% layout("layouts/boilerplate") %>

<div class="hero">
    <div class="hero-content">
        <h1>Welcome to Wanderlust</h1>

        <p>
            Discover amazing places to stay around the world.
            Book unique homes, villas, cabins, and luxury stays
            with ease.
        </p>

        <a href="/listings" class="btn btn-danger btn-lg">
            Explore Listings
        </a>
    </div>
</div>

<section class="features container mt-5">

    <div class="row text-center">

        <div class="col-md-4">
            <i class="fa-solid fa-earth-americas feature-icon"></i>
            <h4>Worldwide Destinations</h4>
            <p>Explore thousands of beautiful locations.</p>
        </div>

        <div class="col-md-4">
            <i class="fa-solid fa-house feature-icon"></i>
            <h4>Premium Stays</h4>
            <p>Luxury villas, apartments and cabins.</p>
        </div>

        <div class="col-md-4">
            <i class="fa-solid fa-star feature-icon"></i>
            <h4>Trusted by Travelers</h4>
            <p>Safe, secure and highly rated properties.</p>
        </div>

    </div>

</section>