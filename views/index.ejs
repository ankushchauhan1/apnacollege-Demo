<% layout("layouts/boilerplate") %>

<style>
    #filters{
        display:flex;
        flex-wrap:wrap;
        align-items:center;
        justify-content:space-between;
        gap:1rem;
        margin:1rem 0 2rem 0;
    }

    .filter{
        text-decoration:none;
        color:#222;
        text-align:center;
        opacity:0.7;
        transition:0.2s;
    }

    .filter:hover{
        opacity:1;
        color:#fe424d;
    }

    .filter i{
        font-size:1.4rem;
    }

    .filter p{
        font-size:0.8rem;
        margin-top:0.3rem;
        margin-bottom:0;
    }

    .listing-link{
        text-decoration:none;
    }

    .listing-card{
        border:none !important;
        margin-bottom:2rem;
    }

    .card-img-top{
        border-radius:1rem !important;
        width:100%;
        height:20rem;
        object-fit:cover;
    }

    .card-body{
        padding:0.5rem 0 !important;
    }

    .card-img-overlay{
        opacity:0;
    }

    .card-img-overlay:hover{
        opacity:0.2;
        background:white;
    }

    .tax-toggle{
        border:1px solid #d3d3d3;
        border-radius:1rem;
        padding:0.8rem 1rem;
        display:flex;
        align-items:center;
    }

    .tax-info{
        display:none;
        color:green;
        font-weight:600;
    }
</style>

<div id="filters">

    <a href="/listings" class="filter">
        <i class="fa-solid fa-border-all"></i>
        <p>All</p>
    </a>

    <a href="/listings?category=Trending" class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic Cities" class="filter">
        <i class="fa-solid fa-city"></i>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains" class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Amazing Pools" class="filter">
        <i class="fa-solid fa-water"></i>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Arctic" class="filter">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Beach" class="filter">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach</p>
    </a>

    <a href="/listings?category=Forest" class="filter">
        <i class="fa-solid fa-tree"></i>
        <p>Forest</p>
    </a>

    <a href="/listings?category=Cabins" class="filter">
        <i class="fa-solid fa-house"></i>
        <p>Cabins</p>
    </a>

    <a href="/listings?category=Boats" class="filter">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
    </a>

    <a href="/listings?category=Castles" class="filter">
        <i class="fa-solid fa-landmark"></i>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Lakefront" class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Lakefront</p>
    </a>

    <a href="/listings?category=Farms" class="filter">
        <i class="fa-solid fa-tractor"></i>
        <p>Farms</p>
    </a>

    <a href="/listings?category=Luxury" class="filter">
        <i class="fa-solid fa-gem"></i>
        <p>Luxury</p>
    </a>

    <div class="d-flex align-items-center gap-3 ">

    <div class="tax-toggle">

        <div class="form-check form-switch form-check-reverse">

            <label class="form-check-label" for="tax-switch">
                Display Total after Taxes
            </label>

            <input
                class="form-check-input"
                type="checkbox"
                id="tax-switch"
            >

        </div>

    </div>

    <form action="/listings" method="GET">

    <select
        class="form-select"
        name="maxPrice"
        onchange="this.form.submit()"
    >
        <option value="">Price</option>
        <option value="1000">Under ₹1,000</option>
        <option value="2000">Under ₹2,000</option>
        <option value="5000">Under ₹5,000</option>
        <option value="10000">Under ₹10,000</option>
    </select>

</form>

</div>

</div>

<div class="row mt-3">

    <% for(let listing of listings){ %>

        <div class="col-lg-4 col-md-6">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                    >

                    <div class="card-img-overlay"></div>

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= listing.title %>
                        </h5>

                        <p class="card-text">

                            ₹
                            <span class="price">
                                <%= listing.price.toLocaleString("en-IN") %>
                            </span>
                            / night

                            <span
                                class="tax-info"
                                data-price="<%= listing.price %>"
                            >
                            </span>

                        </p>

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>

<script>
    const taxSwitch = document.querySelector("#tax-switch");
    const taxInfos = document.querySelectorAll(".tax-info");
    const prices = document.querySelectorAll(".price");

    taxSwitch.addEventListener("change", () => {

        for (let i = 0; i < prices.length; i++) {

            let originalPrice = Number(taxInfos[i].dataset.price);

            if (taxSwitch.checked) {

                let totalPrice = Math.round(originalPrice * 1.18);

                prices[i].innerText = totalPrice.toLocaleString("en-IN");

                taxInfos[i].innerText = " (incl. GST)";
                taxInfos[i].style.display = "inline";

            } else {

                prices[i].innerText = originalPrice.toLocaleString("en-IN");

                taxInfos[i].style.display = "none";
            }
        }
    });
</script>