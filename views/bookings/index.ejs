<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <h2 class="mb-4 text-center">
        My Bookings
    </h2>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-warning text-center">
            <h4>No bookings yet!</h4>
            <a href="/listings" class="btn btn-danger mt-3">
                Explore Listings
            </a>
        </div>

    <% } else { %>

        <div class="row">

        <% bookings.forEach((booking)=>{ %>

            <div class="col-lg-6 mb-4">

                <div class="card shadow-lg border-0 rounded-4">

                    <img
                        src="<%= booking.listing.image.url %>"
                        class="card-img-top"
                        style="height:250px;object-fit:cover;"
                    >

                    <div class="card-body">

                        <h4>
                            <%= booking.listing.title %>
                        </h4>

                        <p class="text-muted">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= booking.listing.location %>,
                            <%= booking.listing.country %>
                        </p>

                        <hr>

                        <p>

                            <strong>Check In :</strong>

                            <%= booking.checkIn.toDateString() %>

                        </p>

                        <p>

                            <strong>Check Out :</strong>

                            <%= booking.checkOut.toDateString() %>

                        </p>

                        <p>

                            <strong>Guests :</strong>

                            <%= booking.guests %>

                        </p>

                        <p>

                            <strong>Total Paid :</strong>

                            ₹ <%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : "0" %>

                        </p>

                        <p>

                            <strong>Status :</strong>

                            <span class="badge bg-success">

                                <%= booking.status %>

                            </span>

                        </p>

                        <div class="mt-3">

                            <a
    href="/bookings/<%= booking._id %>/invoice"
    class="btn btn-dark"
>
    <i class="fa-solid fa-file-pdf"></i>
    Download Invoice
</a>

                            <form
                                action="/bookings/<%= booking._id %>?_method=DELETE"
                                method="POST"
                                class="d-inline"
                            >

                                <button
    class="btn btn-danger"
    onclick="return confirm('Are you sure you want to cancel this booking?')"
>
    Cancel Booking
</button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

        </div>

    <% } %>

</div>