<% layout("layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <h3><%= listing.title %></h3>

        <div class="card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    Owned by:
                    <i><%= listing.owner.username %></i>
                </p>

                <p class="card-text">
                    <strong>Description:</strong><br>
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>Price:</strong>
                    ₹ <%= listing.price.toLocaleString("en-IN") %>/night
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </p>
            </div>
        </div>

        <% if(currentUser && listing.owner._id.equals(currentUser._id)){ %>

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark mt-3"
        >
            Edit
        </a>

        <form
            action="/listings/<%= listing._id %>?_method=DELETE"
            method="POST"
            class="d-inline"
        >
            <button class="btn btn-danger mt-3">
                Delete
            </button>
        </form>

        <% } %>

    </div>
</div>

<hr>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h3>Where you'll be</h3>

        <div
            id="map"
            style="height:400px;border-radius:12px;"
        ></div>

    </div>
</div>

<hr>

<% if(currentUser){ %>

<div class="row">
    <div class="col-8 offset-2">

        <h4>Leave a Review</h4>

        <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            class="needs-validation"
            novalidate
        >

            <fieldset class="starability-slot">
                <legend>Rating</legend>

                <input
                    type="radio"
                    id="no-rate"
                    class="input-no-rate"
                    name="review[rating]"
                    value="1"
                    checked
                >

                <input type="radio" id="rate1" name="review[rating]" value="1">
                <label for="rate1">1 star</label>

                <input type="radio" id="rate2" name="review[rating]" value="2">
                <label for="rate2">2 stars</label>

                <input type="radio" id="rate3" name="review[rating]" value="3">
                <label for="rate3">3 stars</label>

                <input type="radio" id="rate4" name="review[rating]" value="4">
                <label for="rate4">4 stars</label>

                <input type="radio" id="rate5" name="review[rating]" value="5">
                <label for="rate5">5 stars</label>

            </fieldset>

            <div class="mb-3 mt-3">
                <label class="form-label">
                    Comment
                </label>

                <textarea
                    class="form-control"
                    name="review[comment]"
                    rows="4"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a comment.
                </div>
            </div>

            <button class="btn btn-outline-dark">
                Submit Review
            </button>

        </form>

    </div>
</div>

<% } %>

<hr>
<hr>

<% if(currentUser){ %>

<div class="row mb-4">

    <div class="col-8 offset-2">

        <div class="card p-4 shadow">

            <h3 class="mb-4">
                Reserve this Stay
            </h3>

            <form action="/listings/<%= listing._id %>/book" method="POST">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Check In
                        </label>

                        <input
                            type="date"
                            class="form-control"
                            id="checkIn"
                            name="checkIn"
                            required
                        >

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Check Out
                        </label>

                        <input
                            type="date"
                            class="form-control"
                            id="checkOut"
                            name="checkOut"
                            required
                        >

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Guests
                        </label>

                        <input
    type="number"
    class="form-control"
    id="guests"
    name="guests"
    value="1"
    min="1"
    max="10"
    required
>

                    </div>

                </div>

                <hr>

                <h4 class="mb-3">

    ₹ <%= listing.price.toLocaleString("en-IN") %> / night

</h4>

<h5 class="mt-3">
    Nights :
    <span id="nightCount">0</span>
</h5>

<h5>
    Room Price :
    ₹ <span id="roomPrice">0</span>
</h5>

<h5>
    Guest Charge :
    ₹ <span id="guestCharge">0</span>
</h5>

<hr>

<h4 class="text-success">
    Total Amount :
    ₹ <span id="totalPrice">0</span>
</h4>

<p class="text-muted">
    ₹500 extra per additional guest per night.
</p>

<input
    type="hidden"
    name="totalPrice"
    id="hiddenTotalPrice"
>

<button
    class="btn btn-danger btn-lg mt-3 w-100">
    Reserve
</button>

            </form>

        </div>

    </div>

</div>

<% } %>

<script>

const checkIn = document.querySelector("#checkIn");
const checkOut = document.querySelector("#checkOut");
const guests = document.querySelector("#guests");
const totalPrice = document.querySelector("#totalPrice");
const hiddenTotal = document.querySelector("#hiddenTotalPrice");

const price = <%= listing.price %>;
const extraGuestCharge = 500;

function calculateTotal() {

    if (!checkIn.value || !checkOut.value) {
        totalPrice.innerText = "0";
        hiddenTotal.value = 0;
        return;
    }

    let start = new Date(checkIn.value);
    let end = new Date(checkOut.value);

    let nights = (end - start) / (1000 * 60 * 60 * 24);

    if (nights <= 0) {
        totalPrice.innerText = "0";
        hiddenTotal.value = 0;
        return;
    }

    let guestCount = Number(guests.value);

    let total = price * nights;

    if (guestCount > 1) {
        total += (guestCount - 1) * extraGuestCharge * nights;
    }

    totalPrice.innerText = total.toLocaleString("en-IN");
    hiddenTotal.value = total;
}

checkIn.addEventListener("change", () => {
    checkOut.min = checkIn.value;
    calculateTotal();
});

checkOut.addEventListener("change", calculateTotal);
guests.addEventListener("input", calculateTotal);

</script>

<hr>
<div class="row">
    <div class="col-8 offset-2">

        <h4>All Reviews</h4>

        <% for(let review of listing.reviews){ %>

        <div class="card review-card mb-3">

            <div class="card-body">

                <h5>@<%= review.author.username %></h5>

                <p
                    class="starability-result"
                    data-rating="<%= review.rating %>"
                >
                    Rated <%= review.rating %> stars
                </p>

                <p>
                    <%= review.comment %>
                </p>

                <% if(currentUser && review.author._id.equals(currentUser._id)){ %>

                <form
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    method="POST"
                >
                    <button class="btn btn-danger">
                        Delete
                    </button>
                </form>

                <% } %>

            </div>

        </div>

        <% } %>

    </div>
</div>

<div
    id="map-data"
    data-listing='<%- JSON.stringify(listing) %>'>
</div>

<script src="/js/map.js"></script>